NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for background Web Push. Never expose the two server-only values below.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
SUPABASE_SERVICE_ROLE_KEY=

# Optional TURN server for calls outside the same local network.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# Opt-in E2E mutations. Prefer a disposable Supabase project.
E2E_MUTATION_TESTS=false
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# Alternative to a pre-seeded account: provision and remove three temporary users per run.
E2E_AUTO_PROVISION=false
E2E_SUPABASE_SERVICE_ROLE_KEY=

# Explicitly opt in to two temporary accounts for voice/video and missed-call E2E tests.
# Uses DIRECT_URL, no email is sent; fixtures are removed after each run.
E2E_DATABASE_CALLS=false
DIRECT_URL=
# Optional local Supabase CA certificate for the rollback-only SQL tests.
DATABASE_CA_CERT_PATH=

# AI agent credentials (server only). Generate a random 32-byte base64 key.
AI_CONFIG_ENCRYPTION_KEY=
# Exact HTTPS origins, comma separated; do not include /webhook paths.
# Public IPv4 DNS is required in production. Localhost HTTP is development-only.
N8N_ALLOWED_ORIGINS=https://n8n.example.com

# Optional: Stop the n8n execution as well as the Chatly response.
# Server only. The API origin must match the agent webhook origin.
N8N_API_URL=https://n8n.example.com/api/v1
N8N_API_KEY=
# Reachable from n8n, ending with /api/ai/executions.
# Local n8n in Docker: http://host.docker.internal:3000/api/ai/executions
N8N_CHATLY_CALLBACK_URL=https://chatly.example.com/api/ai/executions
