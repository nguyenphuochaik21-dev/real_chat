NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for background Web Push. Never expose the two server-only values below.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
SUPABASE_SERVICE_ROLE_KEY=

# Optional TURN server for calls outside the same local network.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# Opt-in E2E mutations. Prefer a disposable Supabase project.
E2E_MUTATION_TESTS=false
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# Alternative to a pre-seeded account: provision and remove three temporary users per run.
E2E_AUTO_PROVISION=false
E2E_SUPABASE_SERVICE_ROLE_KEY=
